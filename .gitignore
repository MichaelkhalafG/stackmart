# ─────────────────────────────────────────────────────────────────────────────
# STACKMART monorepo — root .gitignore ( /api = Laravel 11 · /web = Next.js )
# Golden rule: NEVER commit real secrets. Ignore every .env, keep only .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment / secrets (highest priority) ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
auth.json

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
vendor/

# ── Package-manager lockfiles: pnpm ONLY for /web (never npm/yarn) ───────────
package-lock.json
yarn.lock

# ── Next.js ( /web ) ─────────────────────────────────────────────────────────
/web/.next/
/web/out/
/web/build/
/web/.vercel/
/web/next-env.d.ts
/web/coverage/
/web/.turbo/
*.tsbuildinfo

# ── Laravel ( /api ) ─────────────────────────────────────────────────────────
/api/vendor/
/api/node_modules/
/api/public/build/
/api/public/hot/
/api/public/storage
/api/storage/*.key
/api/storage/pail/
/api/storage/app/public/
/api/storage/framework/cache/data/*
/api/storage/framework/sessions/*
/api/storage/framework/testing/*
/api/storage/framework/views/*
/api/storage/logs/*
/api/bootstrap/cache/*.php
/api/.phpunit.result.cache
/api/.phpunit.cache/
/api/Homestead.json
/api/Homestead.yaml

# ── Build / dist output ──────────────────────────────────────────────────────
dist/
build/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code
.claude/
